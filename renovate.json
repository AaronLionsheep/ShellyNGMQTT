{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements\\.txt$/"],
    "rangeStrategy": "update-lockfile"
  },
  "pip_requirements": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": ["cryptography"],
      "allowedVersions": "<49.0.0"
    },
    {
      "matchPackageNames": ["bthome-ble"],
      "allowedVersions": "<3.23.5"
    }
  ]
}
